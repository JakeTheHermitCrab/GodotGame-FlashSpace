[sub_resource type="GDScript" id="GDScript_5o0v8"]
script/source = "extends AnimatedSprite2D
@onready var main = get_tree().current_scene
var end_pos: Vector2

func _process(delta):
	if main.instancePos != null:
		end_pos = main.instancePos
		var distance = global_position.distance_to(end_pos)
		if Global.isCompassSelected == 1:
			if distance < 1000:
				print(\"super close\")
			elif distance < 2000:
				print(\"very close\")
			elif distance < 3000:
				print(\"fairly close\")
			elif distance < 4000:
				print(\"somewhat close\")
			elif distance < 5000:
				print(\"getting close\")
			elif distance < 6000:
				print(\"not that far\")
			elif distance < 7000:
				print(\"somewhat far\")
			elif distance < 8000:
				print(\"kind of far\")
			elif distance < 9000:
				print(\"fairly far\")
			elif distance < 10000:
				print(\"very far\")
			else:
				print(\"extremely far\")
"

