[sub_resource type="GDScript" id="GDScript_5o0v8"]
script/source = "extends AnimatedSprite2D
@onready var main = get_tree().current_scene
var end_pos: Vector2
var time := 0.0
var blink_interval := 1.0

func _ready():
	hide()

func _process(delta):
	if main.instancePos == null:
		return
	end_pos = main.instancePos
	var distance = global_position.distance_to(end_pos)
	if Global.isCompassSelected != 1:
		hide()
		return
	if distance < 1000:
		blink_interval = 0.2
	elif distance < 2000:
		blink_interval = 0.5
	elif distance < 3000:
		blink_interval = 0.9
	elif distance < 4000:
		blink_interval = 1.5
	elif distance < 5000:
		blink_interval = 2.0
	elif distance < 6000:
		blink_interval = 3.0
	elif distance < 7000:
		blink_interval = 4.0
	elif distance < 8000:
		blink_interval = 5.0
	elif distance < 9000:
		blink_interval = 6.0
	elif distance < 10000:
		blink_interval = 7.0
	else:
		blink_interval = 8.0
	time += delta
	if time >= blink_interval:
		visible = !visible
		$\"../beep\".play()
		time = 0.0
"

